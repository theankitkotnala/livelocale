{
  "name": "@livelocale/browser",
  "version": "0.1.0",
  "description": "Browser translation provider and IndexedDB cache for LiveLocale",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theankitkotnala/livelocale.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/theankitkotnala/livelocale#readme",
  "bugs": {
    "url": "https://github.com/theankitkotnala/livelocale/issues"
  },
  "keywords": ["localization", "i18n", "browser", "translation", "livelocale"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@livelocale/core": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
