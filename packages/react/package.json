{
  "name": "@livelocale/react",
  "version": "0.1.1",
  "description": "React bindings for LiveLocale localization and translation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theankitkotnala/livelocale.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/theankitkotnala/livelocale#readme",
  "bugs": {
    "url": "https://github.com/theankitkotnala/livelocale/issues"
  },
  "keywords": ["localization", "i18n", "react", "translation", "livelocale", "AI based translation"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "dependencies": {
    "@livelocale/core": "0.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
